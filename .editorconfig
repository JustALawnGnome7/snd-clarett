# Kernel coding style: tabs are 8 columns, and continuation lines align
# with tabs plus spaces on that basis. See https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h}]
indent_style = tab
indent_size = 8
tab_width = 8
max_line_length = 80

[Makefile]
indent_style = tab
tab_width = 8
